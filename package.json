{
  "name": "scholarics",
  "version": "2.0.0",
  "description": "Scholarics — Academic Tools & AI (Cloudflare Pages + Functions)",
  "private": true,
  "scripts": {
    "build": "node tools/build-assets.mjs",
    "dev": "wrangler pages dev . --compatibility-date=2024-11-01 --ip 0.0.0.0 --port 8788",
    "deploy": "npm run build && wrangler pages deploy .",
    "test": "node tests/run-all.js"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "jsdom": "^24.1.3",
    "wrangler": "^3.78.0"
  },
  "engines": {
    "node": ">=18"
  }
}
