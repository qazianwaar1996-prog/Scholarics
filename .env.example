# ─────────────────────────────────────────────────────────────
# Scholarics AI backend — environment configuration
# Copy to ".env" for local development. In production (Replit/Render/
# Railway/Fly/etc.) set these as environment variables / secrets directly.
# NEVER commit a real .env file. NEVER put these values in frontend code.
# ─────────────────────────────────────────────────────────────

# REQUIRED: your Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Gemini model to use (latest stable production model recommended).
# Default: gemini-2.0-flash   (fast, cheap, capable). Set to e.g.
# gemini-2.5-flash / gemini-2.5-pro when those are GA and you prefer them.
GEMINI_MODEL=gemini-2.0-flash

# Server
PORT=3000
NODE_ENV=production

# Rate limiting (per client IP)
RATE_LIMIT=20            # requests per window
RATE_WINDOW_MS=60000     # window length (ms)

# Max request body size (bytes)
MAX_BODY_BYTES=131072

# Logging level: debug | info | warn | error
LOG_LEVEL=info

# TESTING ONLY — set to 1 to run the AI endpoints without a real key
# (returns canned responses). NEVER enable in production.
# AI_MOCK=1
