# ─────────────────────────────────────────────────────────────
# Scholarics AI backend — environment configuration
# Copy to ".env" for local development. In production (Replit/Render/
# Railway/Fly/etc.) set these as environment variables / secrets directly.
# NEVER commit a real .env file. NEVER put these values in frontend code.
# ─────────────────────────────────────────────────────────────

# REQUIRED: your Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Optional Gemini model override. If omitted, the backend uses the current
# stable production default shown here. Configure this as a plain server-side
# Cloudflare variable (never as a VITE_/NEXT_PUBLIC_ browser variable).
GEMINI_MODEL=gemini-3.6-flash

# Server
PORT=3000
NODE_ENV=production

# Rate limiting (per client IP)
RATE_LIMIT=20            # requests per window
RATE_WINDOW_MS=60000     # window length (ms)

# Max request body size (bytes)
MAX_BODY_BYTES=131072

# Logging level: debug | info | warn | error
LOG_LEVEL=info

# TESTING ONLY — set to 1 to run the AI endpoints without a real key
# (returns canned responses). NEVER enable in production.
# AI_MOCK=1

# ─────────────────────────────────────────────────────────────
# AI free-tier quota & kill switch  (functions/_lib/aiQuota.js)
# One central mechanism for every /api/ai/* endpoint. Counters are stored
# server-side in the RATE_LIMIT_KV namespace, keyed by a salted hash of an
# anonymous visitor id (with an IP-hash fallback) — no login, minimal PII.
# Quota is only consumed when a request actually succeeds.
# ─────────────────────────────────────────────────────────────

# Global kill switch. Set to 0/false to disable ALL AI endpoints — no Gemini
# request is made and every AI route returns a friendly unavailable message.
AI_GLOBAL_ENABLED=1

# Per-tool kill switches. Tool names: chat, paraphrase, study-plan, coach,
# flashcards, quiz. Use the uppercased name with "-" replaced by "_".
# AI_ENABLED_CHAT=0
# AI_ENABLED_PARAPHRASE=0
# AI_ENABLED_STUDY_PLAN=0
# AI_ENABLED_COACH=0
# AI_ENABLED_FLASHCARDS=0
# AI_ENABLED_QUIZ=0

# Alternative to the switches above: a comma-separated disable list.
# AI_DISABLED_TOOLS=quiz,flashcards

# Per-tool daily limits per visitor (UTC day). Defaults shown.
AI_DAILY_CHAT=5
AI_DAILY_PARAPHRASE=5
AI_DAILY_STUDY_PLAN=3
AI_DAILY_COACH=3
AI_DAILY_FLASHCARDS=3
AI_DAILY_QUIZ=3

# Global daily limit per visitor across ALL AI tools. Switching pages does not
# reset it, so this is the real ceiling on free AI usage.
AI_DAILY_GLOBAL=10

# Short-term AI burst limit (separate from the general RATE_LIMIT above).
AI_RATE_LIMIT=5          # AI requests per window, per visitor
AI_RATE_WINDOW_MS=60000  # window length (ms)
AI_IP_MULTIPLIER=4       # shared IPs (campus/library NAT) get this many times
                         # the burst allowance before being throttled

# Secret salt for hashing visitor ids and IPs before they are used as KV keys.
# Set this in production to any long random string.
AI_QUOTA_SALT=
